# Capture-node configuration for tools/bootstrap_capture_node.sh
# Copy to capture_node.env and edit. Everything has a default; only a few
# entries normally need changing on a fresh rented box.

# --- paths -----------------------------------------------------------------
# REPO_ROOT defaults to the parent of tools/, i.e. the unpacked repo.
# SDK_ROOT/HOME are created by the script.
# SDK_ROOT=$HOME/android-sdk
# APK=/path/to/cr-ai-offline6.apk            # default: ../render-apk/cr-ai-offline6.apk
# DATASET_ROOT=$HOME/firstlight_data/IL_full
# OUTPUT_DIR=$HOME/event-obs
# PY=$REPO_ROOT/.venv/bin/python

# --- scale -----------------------------------------------------------------
# Empirical: one 6-engine AVD needs ~6-8 cores and ~14-20 GB RAM.
# 64 cores / 256 GB  -> AVD_COUNT=4 (24 engines)
# 32 cores / 128 GB  -> AVD_COUNT=2 (12 engines)
AVD_COUNT=4
ENGINES_PER_AVD=6

# --- engine ports ----------------------------------------------------------
# First AVD uses HOST_BASE..+5, each following AVD shifts by +100.
# Pick a free range; each capture node must be unique if pushing to one trainer.
HOST_BASE=30089

# --- work partition --------------------------------------------------------
# Several nodes share the dataset by index stride: node i uses
# PARTITION_INDEX=i with PARTITION_COUNT=<node count>.
PARTITION_INDEX=0
PARTITION_COUNT=1
SOURCE_COUNT=252238

# --- AVD images ------------------------------------------------------------
# Strongly recommended once an existing worker is reachable: migrate its
# ~/.android/avd (it contains the game's downloaded resource update).
# Produce it on the source with:  tar czf avd.tgz -C ~/.android avd
# AVD_IMAGE_TARBALL=/path/to/avd.tgz

# --- pushing shards to the trainer (optional) ------------------------------
# TRAINER_TARGET=user@trainer-host:/path/to/event-staging
# TRAINER_KEY=$HOME/.ssh/firstlight-push-link
